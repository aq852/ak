TRIAL_LIMIT=5
TRIAL_PERIOD_DAYS=1

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
AUTO_DELETE_DELAY=120

# Languages
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi
